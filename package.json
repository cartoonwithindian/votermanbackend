    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "jose": "^5.9.6",
    "mongodb": "^7.6.0",
    "node-appwrite": "^29.0.0",
