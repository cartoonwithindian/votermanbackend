{
  "name": "voteweb-backend",
  "version": "1.0.0",
  "description": "Backend API for voting web application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "migrate": "node migrate.js up",
