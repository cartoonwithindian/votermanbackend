# ===========================================
# VoteWeb Backend - Environment Configuration
# ===========================================
# Copy this file to .env for local development
# NEVER commit .env to version control

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3000
NODE_ENV=development  # development, test, or production

# ===========================================
# POSTGRESQL CONFIGURATION
# ===========================================
# Option 1: Use DATABASE_URL (RECOMMENDED for production - Railway/Render)
DATABASE_URL=postgres://user:password@host:5432/database

# Option 2: Individual connection parameters (for local development only)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=voteweb
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Enable SSL for hosted PostgreSQL (required for Railway/Render)
DB_SSL=true

# ===========================================
# CONNECTION POOL SETTINGS
# ===========================================
# For 2-3k users, conservative pool sizing is appropriate
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ===========================================
# SECURITY - SESSION
# ===========================================
# Secret for hashing session tokens (REQUIRED in production)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_64_char_random_string

# Session TTL in hours
SESSION_TTL_HOURS=8

# ===========================================
# SECURITY - MFA/TOTP
# ===========================================
# Encryption key for TOTP secrets (REQUIRED in production for admin MFA)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=CHANGE_ME_generate_32_char_random_string

# ===========================================
# SECURITY - COOKIES
# ===========================================
# Set to 'true' in production (requires HTTPS)
COOKIE_SECURE=false

# Cookie SameSite setting: 'lax', 'strict', or 'none'
COOKIE_SAMESITE=lax

# ===========================================
# SECURITY - CORS
# ===========================================
# Allowed origins (comma-separated for multiple)
# For Vercel frontend: CORS_ORIGIN=https://your-app.vercel.app
# For local development: CORS_ORIGIN=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ===========================================
# CLERK AUTHENTICATION
# ===========================================
# Get these values from the Clerk dashboard. Never expose the secret key.
# CLERK_APP_DOMAIN: your Clerk custom front-end API domain (the domain encoded
# in the publishable key, e.g. clerk.example.com). Used by src/app.js to build
# the CORS allowlist.
# CLERK_ISSUER / CLERK_JWKS_URL must use the SAME domain as CLERK_APP_DOMAIN.
# Set these per deployment — nothing is hardcoded in the app.
CLERK_APP_DOMAIN=clerk.example.com
CLERK_ISSUER=https://clerk.example.com
CLERK_SECRET_KEY=sk_test_replace_me

# ===========================================
# SECURITY - OTP
# ===========================================
# Secret for hashing OTPs (REQUIRED in production)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=CHANGE_ME_generate_32_char_random_string

# ===========================================
# BREVO EMAIL (Transactional Emails)
# ===========================================
# Brevo API key from https://app.brevo.com/settings/keys
# Get your free API key from Brevo dashboard
BREVO_API_KEY=your_brevo_api_key_here

# Sender email (must be verified in Brevo)
BREVO_SENDER_EMAIL=made.aofficial1@gmail.com

# Sender name
BREVO_SENDER_NAME=Vote-web

# ===========================================
# APPWRITE STORAGE — Education Pack (Profile Images & Candidate Photos)
# ===========================================
# Two Appwrite buckets on Education (150 GB): "candidate-photos" + "profile-images" (was single bucket on Free)
# "Profile Images & Candidate Photos" to stay within tier-0 1-bucket limit.
# Folders separate concerns inside the same bucket:
#   candidates/ : candidate application photos (POST /api/v1/uploads/photo)
#   profiles/   : user profile avatars      (POST /api/v1/uploads/profile)
# Education pack bucket config (applied via Appwrite console / MCP):
#   max 5 MB, zstd, antivirus=true, encryption=true, transformations=true,
#   allowed: jpg jpeg png webp heic heif, public read ("any").
# Your org "GitHub Student Organization" (auto-1, draft) lifts free-tier storage
# quota when activated; bucket lives in project 6a961a3200335ef36ba8 (fra).
#
# Endpoint + project for the Appwrite project hosting the bucket
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id

# API key with files.read + files.write + buckets.read scopes
APPWRITE_API_KEY=your_appwrite_api_key_here

# Storage bucket for all profile/candidate photos (public read)
# Keep as "candidate-photos" (bucket $id); display name is "Profile Images & Candidate Photos"
APPWRITE_PHOTOS_BUCKET=candidate-photos
# Alias for profile avatar uploads — same physical bucket, different folder
APPWRITE_PROFILE_BUCKET=profile-images
# Optional: override folder names (defaults: candidates / profiles)
# APPWRITE_PHOTOS_FOLDER=candidates
# APPWRITE_PROFILE_FOLDER=profiles

# Storage bucket for database snapshot backups (see src/services/backupService.js)
APPWRITE_BACKUPS_BUCKET=db-backups
# How often to run scheduled DB backups, in hours (default 24)
BACKUP_INTERVAL_HOURS=24

# ===========================================
# RATE LIMITING
# ===========================================
# Rate limit window in minutes
# RATE_LIMIT_WINDOW=15

# Max login attempts per window
# RATE_LIMIT_MAX=5

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# These settings are IGNORED when real authentication is enabled
# They exist only for initial development without auth

# Enable development admin bypass (NEVER enable in production!)
ALLOW_DEV_ADMIN=false

# Development admin student ID (optional)
# DEV_ADMIN_ID=1
